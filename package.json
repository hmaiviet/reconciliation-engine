{
  "name": "reconciliation-engine",
  "version": "1.0.0",
  "description": "Reconciles two streams of transaction records into a deterministic report.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "recon": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run build && vitest run --coverage",
    "check:examples": "npm run build && node scripts/check-scenarios.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://hmaiviet@github.com/hmaiviet/reconciliation-engine.git"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
