{
  "name": "reconciliation-engine",
  "version": "1.0.0",
  "description": "Reconciles two streams of transaction records into a deterministic report.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "recon": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:examples": "npm run build && node scripts/check-scenarios.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://hmaiviet@github.com/hmaiviet/reconciliation-engine.git"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
